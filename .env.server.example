# Copy this file to .env on the Ubuntu server, then replace both values.
# The address must be reserved for the server in the office network.
LAN_IP=192.168.1.50
AXORA_HOST=axora.internal

# Render uses this separate database after the hybrid cutover. The original
# local database remains available as an isolated rollback copy.
AXORA_HYBRID_DB_NAME=axora_hybrid

# Approved MVP payment policy: paid checkout (payment) only.
# The application and database enforce the fixed payment method. No payment-method
# environment variable or gateway credential is required.
