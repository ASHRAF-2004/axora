# Axora production environment template.
#
# Copy to the untracked production environment file only during installation.
# This template deliberately contains no passwords, tokens, or session secrets.
# Runtime credentials remain in root-owned files outside Git.

AXORA_HOST=axora.management
# Required only to satisfy the base Compose interpolation. The production
# override replaces it with the loopback origin binding below.
LAN_IP=127.0.0.1
AXORA_HYBRID_DB_NAME=axora_hybrid

# Canonical host-owned persistence paths. The installer must copy and verify
# any existing files before changing mounts; it must never delete the source.
AXORA_SECRETS_DIR=/etc/axora-production/secrets
AXORA_UPLOADS_DIR=/var/lib/axora-production/uploads

# The release image must be an immutable image tag derived from the verified
# 40-character Git commit. The installer writes the real value outside Git.
AXORA_IMAGE=axora-app:<40-character-git-commit>

# Caddy publishes this loopback-only diagnostic origin. The cloudflared
# container reaches Caddy over the private Docker network, not through this
# host port.
AXORA_ORIGIN_BIND=127.0.0.1
AXORA_ORIGIN_PORT=8080

# Integration capabilities are independently reversible and dark by default.
# The encryption key is a root-owned file under AXORA_SECRETS_DIR and is not an
# environment value.
AXORA_EXTERNAL_API_ENABLED=false
AXORA_INTEGRATION_WEBHOOKS_ENABLED=false
AXORA_ZAPIER_ENABLED=false
AXORA_SLACK_ENABLED=false

# Resend is the only active transactional email provider. Leave delivery
# disabled until the Resend API key, verified axora.management sender domain,
# signed webhook secret and provider-event route have been verified.
AXORA_EMAIL_DELIVERY_ENABLED=false
AXORA_EMAIL_EVENTS_ENABLED=false
AXORA_EMAIL_PROVIDER=resend
AXORA_EMAIL_FROM_ADDRESS=noreply@axora.management
AXORA_EMAIL_FROM_NAME=Axora
AXORA_EMAIL_REPLY_TO=support@axora.management
RESEND_DOMAIN_VERIFIED=false
RESEND_WEBHOOK_VERIFIED=false
ACCOUNT_SETUP_TTL_HOURS=24
# Non-secret Resend plan contract. For a paid plan, update the monthly limit
# and leave AXORA_RESEND_DAILY_LIMIT empty when no daily limit applies.
AXORA_RESEND_PLAN=FREE
AXORA_RESEND_MONTHLY_LIMIT=3000
AXORA_RESEND_DAILY_LIMIT=100
# Optional server-only monitored inbox for validated Contact Us submissions.
AXORA_CONTACT_NOTIFICATION_TO=
# Public widget identifier; leave empty until the dedicated production widget
# is approved. Its secret belongs in AXORA_SECRETS_DIR/turnstile_secret.
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAMES=axora.management
AXORA_TURNSTILE_EXPECTED_HOSTNAME=axora.management
