# Axora production environment template.
#
# Copy to the untracked production environment file only during installation.
# This template deliberately contains no passwords, tokens, or session secrets.
# Runtime credentials remain in root-owned files outside Git.

AXORA_HOST=axora.management
# Required only to satisfy the base Compose interpolation. The production
# override replaces it with the loopback origin binding below.
LAN_IP=127.0.0.1
AXORA_HYBRID_DB_NAME=axora_hybrid

# Canonical host-owned persistence paths. The installer must copy and verify
# any existing files before changing mounts; it must never delete the source.
AXORA_SECRETS_DIR=/etc/axora-production/secrets
AXORA_UPLOADS_DIR=/var/lib/axora-production/uploads

# The release image must be an immutable image tag derived from the verified
# 40-character Git commit. The installer writes the real value outside Git.
AXORA_IMAGE=axora-app:<40-character-git-commit>

# Caddy publishes this loopback-only diagnostic origin. The cloudflared
# container reaches Caddy over the private Docker network, not through this
# host port.
AXORA_ORIGIN_BIND=127.0.0.1
AXORA_ORIGIN_PORT=8080
