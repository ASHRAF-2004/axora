{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# Most requests stay tightly bounded. Only authenticated upload surfaces get
	# enough multipart headroom for their server-validated files (the product
	# editor accepts up to eight 5 MB images in one request).
	@email_event_webhook path /api/email/provider-events/cloudflare
	request_body @email_event_webhook {
		max_size 4KB
	}
	@driver_evidence_upload path /api/driver/evidence
	request_body @driver_evidence_upload {
		# One server-validated 5 MB proof file plus multipart fields.
		max_size 6MB
	}
	@bounded_upload path /products* /supplier* /driver*
	request_body @bounded_upload {
		max_size 44MB
	}
	@standard_body not path /api/email/provider-events/cloudflare /api/driver/evidence /products* /supplier* /driver*
	request_body @standard_body {
		max_size 4MB
	}

	@unexpected_host not host {$AXORA_HOST}
	respond @unexpected_host 421

	# Cloudflare can send an edge HTTP request through the encrypted Tunnel.
	# Redirect only that explicit signal; direct local health checks stay HTTP.
	@edge_http {
		host {$AXORA_HOST}
		header X-Forwarded-Proto http
	}
	redir @edge_http https://{$AXORA_HOST}{uri} 308

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Strict-Transport-Security "max-age=15552000"
		X-Permitted-Cross-Domain-Policies "none"
	}

	reverse_proxy app:3000 {
		# This listener is private to the local Tunnel path, whose public side is
		# always HTTPS. Preserve that fact for application redirects and cookies.
		header_up X-Forwarded-Proto "https"

		health_uri /api/health/ready
		health_interval 10s
		health_timeout 3s
		lb_try_duration 5s
	}

	log {
		output stdout
		format json
	}
}
