{
  "name": "axora-app",
  "version": "1.0.0",
  "private": true,
  "description": "Axora secure multi-company procurement platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build && test -f .next/standalone/node_modules/pg-cloudflare/dist/index.js && test -f .next/standalone/node_modules/pg-cloudflare/esm/index.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres-native": "scripts/ci/verify-native-postgres.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test && playwright test --config=playwright.visitor-recovery.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "standalone:stage": "node scripts/prepare-standalone.mjs",
    "standalone:validate": "node scripts/run-standalone-validation.mjs",
    "assets:validate": "node scripts/validate-third-party-assets.mjs --report output/playwright/asset-size-report.json && node scripts/validate-third-party-notices.mjs",
    "links:validate": "node scripts/validate-public-links.mjs",
    "qa:visual": "node scripts/qa/visual-smoke.mjs",
    "bootstrap:review-workbook": "python3 scripts/bootstrap/validate_workbook.py",
    "bootstrap:first-platform-owner": "node scripts/bootstrap/create_first_platform_owner.mjs",
    "email:preview": "node scripts/email/preview.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "axora",
    "procurement",
    "operations"
  ],
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "$sharp",
    "js-yaml": "4.3.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.4",
    "lucide-react": "^1.25.0",
    "maplibre-gl": "5.18.0",
    "next": "^16.2.11",
    "pdfkit": "0.19.1",
    "pg": "^8.22.0",
    "pg-cloudflare": "^1.4.0",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "sharp": "0.35.3",
    "svix": "1.99.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "playwright-core": "^1.61.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
