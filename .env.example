# Optional local fixture mode. Production Compose always forces this off.
DEMO_MODE=false
DEMO_EMAIL=demo@example.invalid
DEMO_PASSWORD=replace-with-a-development-only-password

# Generate at least 32 random bytes. Never commit the real value.
SESSION_SECRET=replace-with-a-long-random-secret

# Server database settings. The Docker deployment reads passwords from files.
DB_HOST=db
DB_PORT=5432
DB_NAME=axora
DB_USER=axora_app
DB_PASSWORD_FILE=/run/secrets/axora_app_password

# Used only when running without Docker.
# DATABASE_URL=postgresql://axora_app:password@127.0.0.1:5432/axora

APP_BASE_URL=https://axora.internal
LAN_IP=192.168.1.50

# Integration capabilities launch independently and remain dark by default.
# Dedicated secret material belongs in secrets/axora_integration_encryption_key,
# never in this environment file.
AXORA_EXTERNAL_API_ENABLED=false
AXORA_INTEGRATION_WEBHOOKS_ENABLED=false
AXORA_ZAPIER_ENABLED=false
AXORA_SLACK_ENABLED=false
# Non-secret Slack application identifiers. Leave empty until a reviewed Slack
# app is configured. Provider secrets are file-mounted from
# secrets/axora_slack_client_secret and secrets/axora_slack_signing_secret.
AXORA_SLACK_APP_ID=
AXORA_SLACK_CLIENT_ID=

# Resend is the only active transactional email provider. API/webhook secrets
# are file-mounted server secrets and must never be committed here.
AXORA_EMAIL_DELIVERY_ENABLED=false
AXORA_EMAIL_EVENTS_ENABLED=false
AXORA_EMAIL_PROVIDER=resend
# Non-secret Resend transactional-plan contract. On a paid plan, set PAID,
# update the monthly allowance, and leave AXORA_RESEND_DAILY_LIMIT empty when
# the account has no daily limit.
AXORA_RESEND_PLAN=FREE
AXORA_RESEND_MONTHLY_LIMIT=3000
AXORA_RESEND_DAILY_LIMIT=100
AXORA_EMAIL_FROM_ADDRESS=no-reply@axora.management
AXORA_EMAIL_FROM_NAME=Axora
AXORA_EMAIL_REPLY_TO=support@axora.management
RESEND_DOMAIN_VERIFIED=false
RESEND_WEBHOOK_VERIFIED=false

# Approved MVP payment policy: paid checkout (payment) only.
# The application and database enforce the fixed payment method. No payment-method
# environment variable or gateway credential is required.
