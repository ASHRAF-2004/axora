# Axora handover environment. Copy to `.env` in this folder and edit.
#   cp .env.handover.example .env
# Secrets are NOT stored here: they are separate files in ./secrets
# (create them with scripts/handover/new-secrets.sh).

# All `docker compose` commands in this folder use these four files.
COMPOSE_FILE=compose.yaml:compose.hybrid.yaml:compose.production.yaml:compose.handover.yaml
COMPOSE_PATH_SEPARATOR=:
COMPOSE_PROJECT_NAME=axora

# Public domain name (no https://). For a local test use: localhost
AXORA_HOST=axora.management

# Locally built image tag (docker compose build app creates it).
AXORA_IMAGE=axora-app:handover

# Persistent paths on this machine (relative to this folder or absolute).
AXORA_SECRETS_DIR=./secrets
AXORA_UPLOADS_DIR=./data/uploads
AXORA_HYBRID_DB_NAME=axora_hybrid

# Caddy origin. Keep 127.0.0.1 so the app is reachable only from this machine
# (Cloudflare Tunnel or your own reverse proxy forwards public traffic to it).
LAN_IP=127.0.0.1
AXORA_ORIGIN_BIND=127.0.0.1
AXORA_ORIGIN_PORT=8080

# Public Contact page. Leave phone/name/address empty to hide those rows.
# Use | to break the address into lines.
AXORA_SUPPORT_EMAIL=support@axora.management
AXORA_SUPPORT_PHONE=
AXORA_SUPPORT_CONTACT_NAME=
AXORA_SUPPORT_ADDRESS=

# Email (Resend). Keep false until secrets/resend_api_key holds a real key and
# the sending domain is verified in Resend (SPF/DKIM DNS records).
AXORA_EMAIL_DELIVERY_ENABLED=false
AXORA_EMAIL_EVENTS_ENABLED=false
AXORA_EMAIL_PROVIDER=resend
AXORA_RESEND_PLAN=FREE
AXORA_RESEND_MONTHLY_LIMIT=3000
AXORA_RESEND_DAILY_LIMIT=100
AXORA_EMAIL_FROM_ADDRESS=noreply@axora.management
AXORA_EMAIL_FROM_NAME=Axora
AXORA_EMAIL_REPLY_TO=support@axora.management
RESEND_DOMAIN_VERIFIED=false
RESEND_WEBHOOK_VERIFIED=false
ACCOUNT_SETUP_TTL_HOURS=24
# Inbox that receives Contact Us notifications (server-only).
AXORA_CONTACT_NOTIFICATION_TO=

# Cloudflare Turnstile (spam protection for the Contact form). The form stays
# disabled until a site key is set here and its secret is in secrets/turnstile_secret.
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAMES=axora.management
AXORA_TURNSTILE_EXPECTED_HOSTNAME=axora.management

# Optional integrations (keep false unless configured).
AXORA_EXTERNAL_API_ENABLED=false
AXORA_INTEGRATION_WEBHOOKS_ENABLED=false
AXORA_ZAPIER_ENABLED=false
AXORA_SLACK_ENABLED=false
AXORA_SSE_ENABLED=true
AXORA_SLACK_APP_ID=
AXORA_SLACK_CLIENT_ID=
