# Non-secret production values consumed by Docker Compose.
# Secrets remain individual files under /etc/axora-production/secrets.
AXORA_HOST=axora.management
# Safe compatibility value for the base Compose interpolation; production
# overrides the published Caddy port with AXORA_ORIGIN_BIND below.
LAN_IP=127.0.0.1
AXORA_HYBRID_DB_NAME=axora_hybrid
AXORA_ORIGIN_BIND=127.0.0.1
AXORA_ORIGIN_PORT=8080
AXORA_SECRETS_DIR=/etc/axora-production/secrets
AXORA_UPLOADS_DIR=/var/lib/axora-production/uploads
# Resend is the only active transactional provider. Leave delivery disabled
# until the API key, verified sender domain, signed webhook secret, and provider
# event route have been verified.
AXORA_EMAIL_DELIVERY_ENABLED=false
AXORA_EMAIL_EVENTS_ENABLED=false
# Optional Axora-owned operating limit for local usage display. This is not a
# Resend credit or provider allowance balance.
AXORA_EMAIL_PERIOD_RECIPIENT_QUOTA=
AXORA_EMAIL_FROM_ADDRESS=noreply@axora.management
AXORA_EMAIL_FROM_NAME=Axora
AXORA_EMAIL_REPLY_TO=support@axora.management
AXORA_EMAIL_PROVIDER=resend
RESEND_DOMAIN_VERIFIED=false
RESEND_WEBHOOK_VERIFIED=false
ACCOUNT_SETUP_TTL_HOURS=24
# Optional server-only monitored inbox for validated Contact Us submissions.
AXORA_CONTACT_NOTIFICATION_TO=
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAMES=axora.management
AXORA_TURNSTILE_EXPECTED_HOSTNAME=axora.management
# The browser-visible driver-map provider contract is generated at image-build
# time from root-owned deploy.env. It is intentionally not a runtime secret or
# a value in runtime.env.
