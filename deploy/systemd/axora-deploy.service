[Unit]
Description=Axora exact-main production deployment
Documentation=https://github.com/ASHRAF-2004/axora
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/etc/axora-production/deploy.env

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=AXORA_CONFIG_FILE=/etc/axora-production/deploy.env
ExecStart=/usr/local/libexec/axora-production/deploy.sh --automatic
TimeoutStartSec=2h
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/axora-production
ReadWritePaths=/var/lib/axora-production /var/log/axora-production /var/cache/axora-production /run/docker.sock
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
